# ==========================================
# CROMMOS PLATAFORMA — BACKEND (plataforma-api) — VARIÁVEIS DE AMBIENTE
# ==========================================
# Copie para .env e preencha. NUNCA commitar o .env nem chaves privadas.
# Tudo é validado no boot (src/config/env.validation.ts): obrigatória ausente
# ou valor inválido derruba a aplicação. `VAR=` vazio conta como ausente.

# ==========================================
# APLICAÇÃO
# ==========================================
NODE_ENV=development
# Opções: development, production, test
PORT=3000
TZ=America/Sao_Paulo

# Base dos links dos e-mails (convite, redefinição de senha) e do redirect da
# confirmação de e-mail (FRONTEND_URL/login?emailConfirmado=1|0).
# OBRIGATÓRIA em produção.
FRONTEND_URL=http://localhost:5173
# Allowlist de CORS: origens dos frontends dos produtos (CSV, sem barra final),
# com credenciais (cookie de refresh). Vazia = vale o FRONTEND_URL. Em
# desenvolvimento o CORS é liberado.
FRONTEND_URLS=
# URL pública desta API (link de confirmação de e-mail). OBRIGATÓRIA em produção.
API_URL=

ENABLE_SWAGGER=false
SWAGGER_USER=
SWAGGER_PASSWORD=
# Confiar em 1 hop de proxy (Coolify/Traefik) para o IP real (rate limit).
# Em produção é ligado automaticamente.
TRUST_PROXY=false
# Cookie httpOnly do refresh (crommos_rt, path /auth). Em produção Secure é o
# padrão. COOKIE_SAMESITE=none exige HTTPS (COOKIE_SECURE=true) — use quando a
# plataforma e o frontend estiverem em sites diferentes. Domínio: _a definir_.
COOKIE_DOMAIN=
COOKIE_SECURE=
COOKIE_SAMESITE=lax
DISABLE_HTTP_COMPRESSION=false

# ==========================================
# BANCO DE DADOS (PostgreSQL) — escreve só no schema crommos
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=plataforma_db
DB_LOGGING=false
# Migrations SQL (database/migrations) no boot; bloqueantes.
DB_RUN_SQL_MIGRATIONS=true
# Banco vazio: esperar o schema de cada produto antes das migrations (B4).
# Vazio = em produção, os produtos configurados abaixo; CSV (ex.: clinic) para
# forçar; `nenhum` desliga.
DB_AGUARDAR_SCHEMAS=

# ==========================================
# TOKENS (JWT RS256)
# ==========================================
# Par de chaves RSA da plataforma. A privada fica SÓ aqui; a pública vai para
# os produtos (PLATAFORMA_JWT_PUBLIC_KEY deles). Gere com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-privada.pem
#   openssl pkey -in jwt-privada.pem -pubout -out jwt-publica.pem
# Cole o PEM inteiro (várias linhas) ou numa linha só com \n escapado:
#   awk 'NF {printf "%s\\n", $0}' jwt-privada.pem
# O boot confere que a pública é a da privada.
PLATAFORMA_JWT_PRIVATE_KEY=
PLATAFORMA_JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# PRODUTOS (API interna nos dois sentidos)
# ==========================================
# Por produto: URL da API (provisionamento do tenant no signup) + chave de
# serviço (header X-Servico-Key, >= 32 caracteres, distinta por produto;
# `openssl rand -hex 32`). As duas ou nenhuma: sem elas o produto não está
# disponível (signup/login dele → 400).
# ex.: CLINIC_API_URL=http://localhost:3001 (clinic-api local)
CLINIC_API_URL=
SERVICO_KEY_CLINIC=
ODONTO_API_URL=
SERVICO_KEY_ODONTO=
VET_API_URL=
SERVICO_KEY_VET=
# Chave que a PLATAFORMA envia ao produto (provisionamento). Vazia = a
# SERVICO_KEY_<PRODUTO> vale nos dois sentidos (compatível). Com ela, cada
# sentido tem a sua: no Clinic é a SERVICO_KEY_PROVISIONAMENTO.
PROVISIONAMENTO_KEY_CLINIC=
PROVISIONAMENTO_KEY_ODONTO=
PROVISIONAMENTO_KEY_VET=

# ==========================================
# COBRANÇA (AbacatePay) E SITUAÇÃO DA ASSINATURA
# ==========================================
# Sem a chave: stub (sem link de pagamento; webhook 404). Chave de dev
# (abc_dev_...) = modo de testes da AbacatePay.
ABACATEPAY_API_KEY=
# Obrigatório com a chave (>= 16). Cadastre o webhook no painel da AbacatePay:
#   https://<plataforma>/webhooks/abacatepay?webhookSecret=<este valor>
ABACATEPAY_WEBHOOK_SECRET=
# Opcionais: base da API (padrão https://api.abacatepay.com/v2) e chave do
# HMAC do webhook (padrão: a chave pública publicada na documentação).
ABACATEPAY_API_URL=
ABACATEPAY_HMAC_KEY=
# Dias depois do vencimento até o modo leitura por inadimplência (padrão 7).
DIAS_TOLERANCIA_INADIMPLENCIA=7

# ==========================================
# BACKOFFICE
# ==========================================
# Baixa manual de fatura: POST /plataforma/faturas/:id/pagar com o header
# X-Plataforma-Key (>= 32 caracteres). Vazio = rota desligada (404).
# Contingência do webhook da AbacatePay.
PLATAFORMA_API_KEY=

# ==========================================
# E-MAIL (Resend)
# ==========================================
# Sem a chave o provider roda em stub (loga, não envia).
RESEND_API_KEY=
# Remetente (domínio verificado na Resend).
EMAIL_FROM=Crommos <contato@crommos.com>
