# Service-local .npmrc (isolated build).
# Coolify Base Directory = this service dir, so the Docker build context is THIS
# folder. These settings must live here.

# Block lifecycle (pre/post install) scripts — supply-chain hardening.
ignore-scripts=true
# Reproducible installs from this service's own lockfile.
package-lock=true
save-exact=true
# Official registry over TLS only.
registry=https://registry.npmjs.org/
strict-ssl=true
# Vulnerability auditing.
audit=true
audit-level=high
# Quieter, deterministic output.
fund=false
update-notifier=false
# NOTE: engines declare Node >=24, but engine-strict is intentionally left OFF so
# the project still installs/builds on Node 22 sandboxes (EBADENGINE stays a warning).
engine-strict=false
# Network resilience.
fetch-retries=2
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
